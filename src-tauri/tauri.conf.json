{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xcare",
  "version": "0.1.0",
  "identifier": "club.skale.xcare",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xcare · Skale Club",
        "width": 1180,
